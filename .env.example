# Required: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Organization and branding
NEXT_PUBLIC_APP_NAME=출장완료
NEXT_PUBLIC_SERVICE_NAME=출장서류 자동화
NEXT_PUBLIC_ORGANIZATION_NAME=소속 기관
NEXT_PUBLIC_BRAND_ENGLISH=BUSINESS TRIP DESK
NEXT_PUBLIC_DEFAULT_ORIGIN=전주
NEXT_PUBLIC_ORIGIN_BASES=전주,군산,김제,남원,완주,진안,무주,장수,임실,고창,부안
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_OG_IMAGE_PATH=/og-travel.png

# Admin UI: app_metadata role=admin is preferred. Email is a fallback only.
NEXT_PUBLIC_ADMIN_ROLES=admin,super_admin
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

# Local development bypass. Never enable this in Vercel Production/Preview.
ALLOW_LOCAL_DEV_USER=false

# Local AI defaults
NEXT_PUBLIC_OLLAMA_BASE_URL=http://127.0.0.1:11434
NEXT_PUBLIC_OLLAMA_PULL_MODEL=qwen2.5:7b
NEXT_PUBLIC_WEB_LLM_MODEL_ID=Qwen2.5-1.5B-Instruct-q4f16_1-MLC

# Optional: data.go.kr MOLIT TAGO general service key
# Leave empty to use saved fares or direct entry.
DATA_GO_KR_SERVICE_KEY=
